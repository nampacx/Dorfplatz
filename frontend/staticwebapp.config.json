{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "azureActiveDirectory": {
        "userDetailsClaim": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/common/v2.0",
          "clientIdSettingName": "ENTRA_CLIENT_ID",
          "clientSecretSettingName": "ENTRA_CLIENT_SECRET"
        }
      },
      "google": {
        "registration": {
          "clientIdSettingName": "GOOGLE_CLIENT_ID",
          "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    { "route": "/api/GetRoles", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/members/*", "allowedRoles": ["admin"] },
    { "route": "/api/moderation/*", "allowedRoles": ["moderator", "admin"] },
    { "route": "/api/account/*", "allowedRoles": ["authenticated"] },
    { "route": "/api/conversations/*", "allowedRoles": ["authenticated"] },
    { "route": "/api/messages", "allowedRoles": ["authenticated"] },
    { "route": "/api/negotiate", "allowedRoles": ["authenticated"] },
    { "route": "/logout", "redirect": "/.auth/logout" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{png,jpg,svg,ico,css,js}"]
  },
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/login" }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
